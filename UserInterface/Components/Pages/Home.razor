@page "/"
@rendermode InteractiveServer
@using System
@using System.Collections.Generic
@using System.Threading.Tasks
@using Models
@using BusinessLogicLayer
@inject IProductService ProductService

<PageTitle>Product Management</PageTitle>

<div class="product-page">
    <div class="page-header">
        <div>
            <p class="eyebrow">INVENTORY MANAGEMENT</p>
            <h1>Product Management</h1>
            <p class="subtitle">
                Manage your products, prices, and inventory records.
            </p>
        </div>

        <div class="header-icon">
            <span>▦</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(isError ? "alert-error" : "alert-success")"
             role="status">
            <span>@(isError ? "!" : "✓")</span>
            <div>@message</div>
            <button type="button"
                    class="alert-close"
                    aria-label="Dismiss message"
                    @onclick="ClearMessage">
                ×
            </button>
        </div>
    }

    <div class="summary-card">
        <div class="summary-icon">▤</div>
        <div>
            <p class="summary-label">Total Products</p>
            <h2>@products.Count</h2>
            <p class="summary-note">Products currently loaded</p>
        </div>
    </div>

    <div class="content-grid">
        <section class="panel form-panel">
            <div class="panel-heading">
                <div>
                    <h2>@(isEditing ? "Edit Product" : "Add New Product")</h2>
                    <p>
                        @(isEditing
                            ? $"Editing product #{productModel.PId}"
                            : "Enter the details below to create a product.")
                    </p>
                </div>
                <span class="panel-symbol">✎</span>
            </div>

            <EditForm Model="@productModel" OnSubmit="@SaveProduct">
                <div class="form-group">
                    <label for="productName">Product name</label>
                    <InputText id="productName"
                               class="form-control"
                               @bind-Value="productModel.ProductName"
                               placeholder="e.g. Football" />
                </div>

                <div class="form-group">
                    <label for="productPrice">Price</label>
                    <InputNumber id="productPrice"
                                 class="form-control"
                                 @bind-Value="productModel.Price"
                                 min="0"
                                 placeholder="Enter price" />
                </div>

                <button type="submit"
                        class="btn-primary"
                        disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>@(isEditing ? "✓ Save Changes" : "+ Add Product")</span>
                    }
                </button>

                @if (isEditing)
                {
                    <button type="button"
                            class="btn-secondary"
                            @onclick="CancelEdit"
                            disabled="@isSaving">
                        Cancel Editing
                    </button>
                }
            </EditForm>
        </section>

        <section class="panel table-panel">
            <div class="panel-heading">
                <div>
                    <h2>All Products</h2>
                    <p>Your saved product records</p>
                </div>
                <span class="count-badge">@products.Count items</span>
            </div>

            @if (isLoading)
            {
                <div class="empty-state">
                    <p>Loading products...</p>
                </div>
            }
            else if (products.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">▤</div>
                    <h3>No products yet</h3>
                    <p>Add your first product using the form.</p>
                </div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="product-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th class="actions-heading">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in products)
                            {
                                <tr @key="item.PId">
                                    <td>
                                        <div class="product-cell">
                                            <div class="product-avatar">
                                                @GetInitial(item.ProductName)
                                            </div>
                                            <div>
                                                <div class="product-name">
                                                    @item.ProductName
                                                </div>
                                                <div class="product-id">
                                                    ID: @item.PId
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="price">
                                            @item.Price.ToString("N0")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <button type="button"
                                                    class="btn-edit"
                                                    @onclick="() => EditProduct(item)"
                                                    disabled="@isSaving">
                                                Edit
                                            </button>
                                            <button type="button"
                                                    class="btn-delete"
                                                    @onclick="() => DeleteProduct(item.PId)"
                                                    disabled="@isSaving">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

<style>
    .product-page {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --text: #172033;
        --muted: #687386;
        --border: #e6eaf0;
        --surface: var(--bs-body-bg, #ffffff);
        --page-bg: var(--bs-tertiary-bg, #f6f8fc);
        color: var(--text);
        min-height: 100vh;
        padding: 32px;
        background: var(--page-bg);
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin: 0 auto 28px;
        max-width: 1500px;
    }

    .eyebrow {
        color: var(--primary);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
        margin: 0 0 9px;
    }

    .page-header h1 {
        font-size: clamp(26px, 3vw, 36px);
        font-weight: 750;
        letter-spacing: -1px;
        margin: 0;
    }

    .subtitle, .panel-heading p {
        color: var(--muted);
        font-size: 14px;
        margin: 8px 0 0;
        line-height: 1.6;
    }

    .header-icon {
        display: grid;
        place-items: center;
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        border-radius: 18px;
        color: white;
        background: linear-gradient(135deg, #6366f1, #4338ca);
        box-shadow: 0 8px 22px #4f46e533;
        font-size: 28px;
    }

    .summary-card {
        display: flex;
        align-items: center;
        gap: 17px;
        max-width: 1500px;
        margin: 0 auto 24px;
        padding: 22px 24px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 3px 12px #17203308;
    }

    .summary-icon {
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        border-radius: 15px;
        background: #eef2ff;
        color: var(--primary);
        font-size: 25px;
    }

    .summary-label, .summary-note {
        color: var(--muted);
        font-size: 12px;
        margin: 0;
    }

    .summary-card h2 {
        font-size: 27px;
        font-weight: 750;
        margin: 3px 0;
    }

    .content-grid {
        display: grid;
        grid-template-columns: minmax(260px, 0.75fr) minmax(0, 1.6fr);
        gap: 24px;
        max-width: 1500px;
        margin: 0 auto;
        align-items: start;
    }

    .panel {
        min-width: 0;
        padding: 25px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--surface);
        box-shadow: 0 4px 18px #17203308;
    }

    .panel-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 25px;
    }

        .panel-heading h2 {
            font-size: 19px;
            font-weight: 750;
            margin: 0;
        }

    .panel-symbol {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 11px;
        color: var(--primary);
        background: #eef2ff;
        font-size: 21px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 650;
            margin-bottom: 8px;
        }

    .form-control {
        width: 100%;
        min-height: 46px;
        padding: 11px 13px;
        border: 1px solid #dce2ec;
        border-radius: 10px;
        color: var(--text);
        background: var(--surface);
        font-size: 14px;
        box-sizing: border-box;
        transition: border-color .2s, box-shadow .2s;
    }

        .form-control:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 0 3px #4f46e51c;
        }

    .btn-primary, .btn-secondary {
        display: block;
        width: 100%;
        min-height: 44px;
        padding: 11px 16px;
        border: 0;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 650;
        cursor: pointer;
        transition: background .2s, transform .2s;
    }

    .btn-primary {
        color: white;
        background: var(--primary);
    }

        .btn-primary:hover:not(:disabled) {
            background: var(--primary-hover);
            transform: translateY(-1px);
        }

    .btn-secondary {
        margin-top: 10px;
        color: var(--text);
        background: #eef1f6;
    }

    button:disabled {
        opacity: .6;
        cursor: not-allowed;
    }

    .count-badge {
        white-space: nowrap;
        border-radius: 20px;
        padding: 7px 10px;
        background: #eef2ff;
        color: var(--primary);
        font-size: 11px;
        font-weight: 750;
    }

    .table-wrapper {
        overflow-x: auto;
        width: 100%;
    }

    .product-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

        .product-table th {
            padding: 13px 12px;
            border-bottom: 1px solid var(--border);
            color: var(--muted);
            font-size: 11px;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .6px;
            white-space: nowrap;
        }

        .product-table td {
            padding: 16px 12px;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
        }

        .product-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .product-table tbody tr:hover {
            background: #64748b08;
        }

    .product-cell {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 140px;
    }

    .product-avatar {
        display: grid;
        place-items: center;
        width: 39px;
        height: 39px;
        flex-shrink: 0;
        border-radius: 12px;
        background: #eef2ff;
        color: var(--primary);
        font-weight: 800;
        text-transform: uppercase;
    }

    .product-name {
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .product-id {
        margin-top: 4px;
        color: var(--muted);
        font-size: 11px;
    }

    .price {
        font-weight: 750;
        white-space: nowrap;
    }

    .actions-heading {
        text-align: right;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 7px;
    }

    .btn-edit, .btn-delete {
        border: 0;
        border-radius: 8px;
        padding: 8px 11px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .btn-edit {
        color: #4338ca;
        background: #eef2ff;
    }

        .btn-edit:hover {
            background: #e0e7ff;
        }

    .btn-delete {
        color: #b91c1c;
        background: #fef2f2;
    }

        .btn-delete:hover:not(:disabled) {
            background: #fee2e2;
        }

    .alert {
        display: flex;
        align-items: center;
        gap: 12px;
        max-width: 1500px;
        margin: 0 auto 22px;
        padding: 14px 16px;
        border-radius: 12px;
        font-size: 13px;
    }

    .alert-success {
        color: #166534;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
    }

    .alert-error {
        color: #991b1b;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    .alert-close {
        margin-left: auto;
        border: 0;
        background: transparent;
        color: inherit;
        font-size: 22px;
        cursor: pointer;
    }

    .empty-state {
        padding: 45px 15px;
        text-align: center;
    }

    .empty-icon {
        display: inline-grid;
        place-items: center;
        width: 55px;
        height: 55px;
        margin-bottom: 12px;
        border-radius: 16px;
        color: var(--primary);
        background: #eef2ff;
        font-size: 26px;
    }

    .empty-state h3 {
        margin: 0;
        font-size: 16px;
    }

    .empty-state p {
        color: var(--muted);
        font-size: 13px;
        margin-top: 8px;
    }

    @@media (max-width: 1000px) {
        .content-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .product-page {
            padding: 20px 12px;
        }

        .panel {
            padding: 18px 13px;
        }

        .page-header h1 {
            font-size: 25px;
        }

        .header-icon {
            width: 46px;
            height: 46px;
        }

        .product-table th,
        .product-table td {
            padding: 12px 8px;
        }

        .action-buttons {
            flex-direction: column;
        }
    }
</style>

@code {
    private ProductModel productModel = new ProductModel();
    private List<ProductModel> products = new List<ProductModel>();

    private string message = "";
    private bool isEditing;
    private bool isLoading = true;
    private bool isSaving;
    private bool isError;

    protected override void OnInitialized()
    {
        LoadProducts();
    }

    private void LoadProducts()
    {
        try
        {
            products = ProductService.GetAllData();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading products: {ex}");
            message = "Could not load products. Check your database connection.";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveProduct(EditContext editContext)
    {
        if (isSaving)
            return;

        ClearMessage();

        string name = productModel.ProductName?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(name))
        {
            message = "Please enter a product name.";
            isError = true;
            return;
        }

        if (productModel.Price < 0)
        {
            message = "Price cannot be negative.";
            isError = true;
            return;
        }

        isSaving = true;

        try
        {
            productModel.ProductName = name;

            bool success;

            if (isEditing)
            {
                success = ProductService.UpdateData(productModel);

                message = success
                    ? "Product updated successfully."
                    : "No product was updated.";
            }
            else
            {
                success = ProductService.InsertData(productModel);

                message = success
                    ? "Product added successfully."
                    : "The product could not be added.";
            }

            isError = !success;

            if (success)
            {
                productModel = new ProductModel();
                isEditing = false;
                LoadProducts();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error saving product: {ex}");
            message = "Could not save the product. Check the database connection.";
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void EditProduct(ProductModel item)
    {
        productModel = new ProductModel
        {
            PId = item.PId,
            ProductName = item.ProductName,
            Price = item.Price
        };

        isEditing = true;
        ClearMessage();
    }

    private async Task DeleteProduct(int id)
    {
        if (isSaving)
            return;

        isSaving = true;
        ClearMessage();

        try
        {
            bool success = ProductService.DeleteData(id);

            if (success)
            {
                message = "Product deleted successfully.";

                if (isEditing && productModel.PId == id)
                {
                    productModel = new ProductModel();
                    isEditing = false;
                }

                LoadProducts();
            }
            else
            {
                message = "No product was deleted.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error deleting product: {ex}");
            message = "Could not delete the product. Check the database connection.";
            isError = true;
        }
        finally
        {
            isSaving = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void CancelEdit()
    {
        productModel = new ProductModel();
        isEditing = false;
        ClearMessage();
    }

    private void ClearMessage()
    {
        message = "";
        isError = false;
    }

    private static string GetInitial(string? name)
    {
        return string.IsNullOrWhiteSpace(name)
            ? "?"
            : name.Trim().Substring(0, 1).ToUpperInvariant();
    }
}
